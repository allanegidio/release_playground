name: Enhanced Release Notes

on:
  push:
    tags:
      - "v*"

permissions:
  contents: write
  pull-requests: read

jobs:
  enhanced-release:
    name: Enhanced Release Notes
    runs-on: ubuntu-latest
    steps:
      - name: Generate GitHub App Token
        id: generate-token
        uses: actions/create-github-app-token@v2
        with:
          app-id: ${{ secrets.APP_ID }}
          private-key: ${{ secrets.APP_PRIVATE_KEY }}

      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ steps.generate-token.outputs.token }}

      - name: Get previous tag
        id: previous_tag
        run: |
          PREVIOUS_TAG=$(git tag --sort=-version:refname | grep -v '${{ github.ref_name }}' | head -n 1)
          echo "previous_tag=${PREVIOUS_TAG}" >> $GITHUB_OUTPUT
          echo "Previous tag: ${PREVIOUS_TAG}"

      - name: Generate Enhanced Release Notes
        uses: actions/github-script@v7
        with:
          github-token: ${{ steps.generate-token.outputs.token }}
          script: |
            const tagName = context.ref.replace('refs/tags/', '');
            const previousTag = '${{ steps.previous_tag.outputs.previous_tag }}';

            // Get commits since last tag
            const comparison = await github.rest.repos.compareCommits({
              owner: context.repo.owner,
              repo: context.repo.repo,
              base: previousTag || 'HEAD~10',
              head: tagName,
            });

            // Extract PR numbers from commit messages
            const prNumbers = new Set();
            const commitRegex = /\(#(\d+)\)|Merge pull request #(\d+)/g;
            
            for (const commit of comparison.data.commits) {
              const matches = [...commit.commit.message.matchAll(commitRegex)];
              matches.forEach(match => {
                const prNum = match[1] || match[2];
                if (prNum) prNumbers.add(parseInt(prNum));
              });
            }

            // Fetch PR details
            const prs = await Promise.all(
              Array.from(prNumbers).map(async (prNumber) => {
                try {
                  const pr = await github.rest.pulls.get({
                    owner: context.repo.owner,
                    repo: context.repo.repo,
                    pull_number: prNumber,
                  });
                  return pr.data;
                } catch (error) {
                  core.warning(`Could not fetch PR #${prNumber}: ${error.message}`);
                  return null;
                }
              })
            );

            // Categorize PRs by labels
            const categories = {
              '🚀 New Features': [],
              '🐛 Bug Fixes': [],
              '📚 Documentation': [],
              '🔧 Maintenance': [],
              '🎨 UI/UX Improvements': [],
              '⚡ Performance': [],
              '🔒 Security': [],
              '🧪 Tests': [],
              '📦 Other Changes': [],
            };

            const labelMap = {
              'feature': '🚀 New Features',
              'enhancement': '🚀 New Features',
              'new': '🚀 New Features',
              'bug': '🐛 Bug Fixes',
              'bugfix': '🐛 Bug Fixes',
              'fix': '🐛 Bug Fixes',
              'hotfix': '🐛 Bug Fixes',
              'documentation': '📚 Documentation',
              'docs': '📚 Documentation',
              'maintenance': '🔧 Maintenance',
              'chore': '🔧 Maintenance',
              'refactor': '🔧 Maintenance',
              'ui': '🎨 UI/UX Improvements',
              'ux': '🎨 UI/UX Improvements',
              'design': '🎨 UI/UX Improvements',
              'performance': '⚡ Performance',
              'optimization': '⚡ Performance',
              'security': '🔒 Security',
              'test': '🧪 Tests',
              'testing': '🧪 Tests',
            };

            for (const pr of prs.filter(Boolean)) {
              let categorized = false;
              for (const label of pr.labels) {
                const category = labelMap[label.name.toLowerCase()];
                if (category) {
                  categories[category].push(pr);
                  categorized = true;
                  break;
                }
              }
              if (!categorized) {
                categories['📦 Other Changes'].push(pr);
              }
            }

            // Build enhanced release body
            let body = `## What's Changed\n\n`;
            body += `This release includes ${comparison.data.total_commits} commit(s) `;
            body += `and ${prs.filter(Boolean).length} pull request(s).\n\n`;

            // Add categorized changes
            for (const [category, items] of Object.entries(categories)) {
              if (items.length > 0) {
                body += `### ${category}\n\n`;
                for (const pr of items) {
                  const author = pr.user.login;
                  body += `- ${pr.title} (#${pr.number}) by @${author}\n`;
                }
                body += '\n';
              }
            }

            // Add contributors section
            const contributors = new Set(
              prs.filter(Boolean).map(pr => pr.user.login)
            );
            if (contributors.size > 0) {
              body += `### 👥 Contributors\n\n`;
              body += `Thank you to all contributors who made this release possible:\n`;
              body += Array.from(contributors).map(c => `@${c}`).join(', ') + '\n\n';
            }

            // Add comparison link
            if (previousTag) {
              body += `**Full Changelog**: https://github.com/${context.repo.owner}/${context.repo.repo}/compare/${previousTag}...${tagName}\n`;
            }

            // Create the release
            const res = await github.rest.repos.createRelease({
              owner: context.repo.owner,
              repo: context.repo.repo,
              tag_name: tagName,
              name: `🎉 Release ${tagName}`,
              body: body,
              draft: false,
              prerelease: tagName.includes('alpha') || tagName.includes('beta') || tagName.includes('rc'),
            });
            
            core.info(`✅ Created enhanced release: ${res.data.html_url}`);

      - name: Create release branch
        shell: bash
        env:
          GITHUB_TOKEN: ${{ steps.generate-token.outputs.token }}
          REPO: ${{ github.repository }}
        run: |
          set -euo pipefail
          TAG_NAME="${GITHUB_REF_NAME}"
          git fetch --tags --force
          git checkout -b "release/${TAG_NAME}" "${GITHUB_SHA}"
          git remote set-url origin "https://x-access-token:${GITHUB_TOKEN}@github.com/${REPO}.git"
          git push -u origin "release/${TAG_NAME}"
